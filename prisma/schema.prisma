// ---------------------- SEGMEN KLIEN ----------------------
model Segment {
  id          String   @id @default(cuid())
  icon        String   @default("Home")
  title       String
  subtitle    String   @default("")
  pointsJson  String   @default("[]")
  order       Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------- FAQ ----------------------
model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------- WILAYAH JANGKAUAN ----------------------
model Region {
  id         String   @id @default(cuid())
  island     String
  citiesJson String   @default("[]")
  order      Int      @default(0)
  visible    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------------------- TESTIMONI ----------------------
model Testimonial {
  id        String   @id @default(cuid())
  name      String
  role      String   @default("")
  initials  String   @default("")
  rating    Int      @default(5)
  text      String
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------- STATISTIK ----------------------
model Stat {
  id        String   @id @default(cuid())
  icon      String   @default("Gem")
  target    Float    @default(0)
  decimals  Int      @default(0)
  suffix    String   @default("")
  label     String
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------- ALUR PEMESANAN ----------------------
model ProcessStep {
  id        String   @id @default(cuid())
  icon      String   @default("MessagesSquare")
  title     String
  body      String
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------- KEUNGGULAN (WHY US) ----------------------
model WhyUsItem {
  id        String   @id @default(cuid())
  icon      String   @default("FlaskConical")
  title     String
  body      String
  order     Int      @default(0)
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------- REGISTRY SECTION ----------------------
// Jantung arsitektur "berkembang bebas": setiap section frontend
// terdaftar di sini — bisa diurut ulang, disembunyikan, atau
// ditambah (plugin-style) tanpa menyentuh kode inti.
model Section {
  id          String   @id @default(cuid())
  key         String   @unique // hero, stats, products, calculator, segments, whyus, process, coverage, testimonials, faq, quote
  title       String
  order       Int      @default(0)
  visible     Boolean  @default(true)
  eyebrow     String   @default("")
  heading     String   @default("")
  highlight   String   @default("")
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------- LEADS / PENAWARAN ----------------------
model QuoteRequest {
  id         String   @id @default(cuid())
  ref        String   @unique
  name       String
  phone      String
  clientType String
  sandType   String
  volume     String
  city       String
  message    String?
  status     String   @default("BARU") // BARU | DIHUBUNGI | PENAWARAN | DEAL | BATAL
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------------------- PENGGUNA ADMIN ----------------------
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("admin") // admin | editor
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------------------- REVISI KONTEN ----------------------
// Seperti WordPress Revisions: setiap perubahan tersimpan, bisa rollback
model ContentRevision {
  id         String   @id @default(cuid())
  entityType String // settings | product | segment | faq | region | testimonial | stat | process | whyus | section
  entityId   String
  label      String   @default("")
  dataJson   String
  createdAt  DateTime @default(now())
}

// ---------------------- LOG AKTIVITAS ----------------------
model ActivityLog {
  id         String   @id @default(cuid())
  adminEmail String
  action     String // create | update | delete | login | export | revert
  entityType String
  entityId   String   @default("")
  detail     String   @default("")
  createdAt  DateTime @default(now())
}
